# LitFoundry Configuration Example
# Copy this file to .env in development and fill in appropriate values.
# In production, use environment variables or a configuration management system.

# Data root directory (optional; uses platform default if not set)
# Windows: %PROGRAMDATA%\LitFoundry
# macOS: ~/Library/Application Support/LitFoundry
# Linux: /var/lib/litfoundry
#LITFOUNDRY_DATA_ROOT=/path/to/data/root

# Run mode: server (behind proxy) or workstation (local only)
LITFOUNDRY_RUN_MODE=server

# Port for the Waitress server (default: 5080)
LITFOUNDRY_PORT=5080

# Trusted proxy IP addresses (comma-separated, empty by default)
# Only requests from these IPs will have X-Forwarded-* headers processed
#LITFOUNDRY_TRUSTED_PROXIES=127.0.0.1,192.168.1.1

# Allowed host names (comma-separated)
LITFOUNDRY_ALLOWED_HOSTS=localhost,127.0.0.1,litfoundry.example.internal

# CORS allowed origins (comma-separated, empty by default = same-origin only)
#LITFOUNDRY_CORS_ORIGINS=https://litfoundry.example.com

# Custom catalogue database path (optional; uses data root if not set)
#LITFOUNDRY_CATALOG_PATH=/custom/path/to/catalog.sqlite
